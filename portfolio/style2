/* =======================
   GLOBAL RESET (YOURS)
======================= */
*{
    margin: 0;
    padding: 0;
    font-family: 'Poppins', sans-serif;
    box-sizing: border-box;
}

html{
    scroll-behavior: smooth;
    overflow-x: hidden;
}

body{
    background: #080808;
    color: #fff;
    overflow-x: hidden;
}

/* =======================
   ROOT VARIABLES
======================= */
:root{
    --max-width: 1200px;
}

/* =======================
   HEADER
======================= */
#header{
    width: 100%;
    height: 100vh;
    background-image: url(images/background.png);
    background-size: cover;
    background-position: center;
}

/* =======================
   CONTAINER (FIXED)
======================= */
/* .container{
    padding: 10px 10%;
} */

.container,
.container-wide{
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 20px;
}

/* =======================
   NAVBAR
======================= */
nav{
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 20px;
}

.logo{
    width: 140px;
}

nav ul li{
    display: inline-block;
    list-style: none;
    margin: 10px 20px;
}

nav ul li a{
    color: #fff;
    text-decoration: none;
    font-size: 18px;
    position: relative;
}

nav ul li a::after{
    content: '';
    width: 0;
    height: 3px;
    background: #ff004f;
    position: absolute;
    left: 0;
    bottom: -6px;
    transition: 0.5s;
}

nav ul li a:hover::after{
    width: 100%;
}

/* =======================
   HERO TEXT
======================= */
.header-text{
    margin-top: 20vh;
    font-size: 30px;
    max-width: 600px;
    margin-left: auto;
    margin-right: 0;
    text-align: right;
}

.header-text h1{
    font-size: 60px;
    margin-top: 20px;
}

.header-text h1 span{
    color: #ff004f;
}

/* =======================
   ABOUT SECTION
======================= */
#about{
    padding: 80px 0;
    color: #ababab;
}

.row{
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 40px;
    align-items: center;
    width: 100%;
}

.about-col-1,
.about-col-2{
    width: 100%;
}

.about-col-1 img{
    width: 100%;
    max-width: 100%;
    border-radius: 15px;
    display: block;
}

.about-col-2 h1{
    font-size: 60px;
    font-weight: 600;
    color: #fff;
}

/* =======================
   TABS
======================= */
.tab-titles{
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin: 20px 0 40px;
}

.tab-links{
    font-size: 18px;
    font-weight: 500;
    cursor: pointer;
    position: relative;
}

.tab-links::after{
    content: '';
    width: 0;
    height: 3px;
    background: #ff004f;
    position: absolute;
    left: 0;
    bottom: -8px;
    transition: 0.5s;
}

.tab-links.active-link::after{
    width: 50%;
}

.tab-contents{
    display: none;
    width: 100%;
}

.tab-contents.active-tab{
    display: block;
}

.tab-contents ul{
    padding-left: 0;
}

.tab-contents ul li{
    list-style: none;
    margin: 10px 0;
}

.tab-contents ul li span{
    color: #b54769;
    font-size: 14px;
}

/* =======================
   SKILLS SECTION
======================= */
#skills .tab-contents{
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 15px;
    width: 100%;
}

#skills .tab-contents li{
    width: 100%;
    text-align: center;
}

/* =======================
   PORTFOLIO
======================= */
#portfolio{
    padding: 50px 0;
}

.work-list{
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 30px;
}

.work{
    border-radius: 10px;
    position: relative;
    overflow: hidden;
    width: 100%;
}

.work img{
    width: 100%;
    border-radius: 10px;
    display: block;
    transition: transform 0.5s;
}

.layer{
    width: 100%;
    height: 100%;
    background: linear-gradient(rgba(0,0,0,0.75), #ff004f);
    border-radius: 10px;
    position: absolute;
    left: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    padding: 20px;
    text-align: center;
    opacity: 0;
    transition: opacity 0.4s;
}

.work:hover img{
    transform: scale(1.1);
}

.work:hover .layer{
    opacity: 1;
}

/* =======================
   CONTACT
======================= */
.contact-left{
    flex-basis: 35%;
}

.contact-right{
    flex-basis: 60%;
}

.social-icons a{
    margin-right: 15px;
    font-size: 25px;
    color: #ababab;
    transition: transform 0.5s;
}

.social-icons a:hover{
    color: #ff004f;
    transform: translateY(-5px);
}

/* =======================
   FOOTER
======================= */
/* .copyright{
    width: 100vw;
    margin-right: 80px;
} */

.copyright{
    width: 100%;
    text-align: center;
    padding: 25px 0;
    background: #262626;
    margin-top: 20px;
}

/* =======================
   MOBILE RESPONSIVE
======================= */
@media (max-width: 768px){

    .header-text{
        margin: 120px auto 0;
        text-align: center;
        font-size: 20px;
    }

    .header-text h1{
        font-size: 40px;
    }

    nav ul{
        width: 100%;
        text-align: center;
    }

    .row{
        text-align: center;
        justify-items: center;
    }

    #skills .tab-contents{
        grid-template-columns: repeat(2, 1fr);
    }

    /* #skills .tab-contents li{
    width: 100%;
    text-align: center;
    } */

    .contact-left,
    .contact-right{
        flex-basis: 100%;
        text-align: center;
    }

    .social-icons{
        display: flex;
        justify-content: center;
    }

    form{
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .about-col-1 img{
        max-width: 90%;
        margin: 0 auto;
    }

    #about{
        padding-left: 0;
        padding-right: 0;
    }

    /* PORTFOLIO POPUP FIX (IMPORTANT BUTTON VISIBLE) */
    .layer{
        position: relative;
        opacity: 1;
    }
}
