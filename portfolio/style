@media (max-width: 768px){

    .header-text{
        text-align: center;
        margin: 100px auto 0;
    }

    nav ul{
        background: #ff004f;
        position: fixed;
        top: 0;
        right: -200px;
        width: 200px;
        height: 100vh;
        padding-top: 60px;
        transition: right 0.3s;
    }

    nav ul li{
        display: block;
        margin: 25px;
    }

    nav .fa-bars{
        display: block;
        font-size: 25px;
    }

    .row{
        grid-template-columns: 1fr;
        text-align: center;
    }
}
